{
  "name": "playwright-zed-language-server",
  "version": "0.5.1",
  "description": "Language server for the Playwright Runner Zed extension: discovers and runs Playwright tests in your workspace (community project, not affiliated with Microsoft)",
  "keywords": [
    "playwright",
    "zed",
    "language-server",
    "lsp",
    "testing"
  ],
  "homepage": "https://github.com/radekBednarik/playwright-zed#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radekBednarik/playwright-zed.git",
    "directory": "server"
  },
  "type": "commonjs",
  "bin": {
    "playwright-zed-language-server": "bin/playwright-zed-language-server.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.4",
    "vscode-jsonrpc": "^8.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
