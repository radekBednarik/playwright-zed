// Zed settings for the screenshot profile (feature 010).
// Copied by site/scripts/zed-screenshot-profile.sh into the profile's config directory.
// Default theme and fonts so the pictures look like a stock Zed, with the two settings
// the extension's labels need turned on.
{
  "theme": { "mode": "system", "light": "One Dark", "dark": "One Dark" },
  "code_lens": "on",
  "inlay_hints": { "enabled": true, "show_type_hints": false, "show_parameter_hints": false, "show_other_hints": true },
  "git": { "inline_blame": { "enabled": false } },
  "vim_mode": false,
  "telemetry": { "diagnostics": false, "metrics": false },
  "restore_on_startup": "none",
  "ui_font_size": 16,
  "buffer_font_size": 15
}
