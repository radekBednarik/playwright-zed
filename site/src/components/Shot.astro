---
// A documentation screenshot from the manifest: optimised image, alt text and a caption
// naming the versions it shows (feature 010).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { screenshots } from '../data/screenshots.ts';

interface Props {
  id: string;
}

const { id } = Astro.props;
const shot = screenshots.find((entry) => entry.id === id);
if (!shot) throw new Error(`Shot: no manifest entry for "${id}" in src/data/screenshots.ts`);

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const image = images[`../assets/screenshots/${id}.png`]?.default;
// SCREENSHOTS_PLACEHOLDER=1 lets the site build before the captures exist (layout checks
// only); a normal build fails on a missing file, as the coverage check does.
const placeholder = !image && process.env.SCREENSHOTS_PLACEHOLDER === '1';
if (!image && !placeholder) throw new Error(`Shot: no file src/assets/screenshots/${id}.png for "${id}"`);
---

<figure class="shot">
  {image ? (
    <Image src={image} alt={shot.alt} width={Math.min(image.width, 1920)} loading="lazy" />
  ) : (
    <div class="placeholder" role="img" aria-label={shot.alt}>Screenshot placeholder: {id}</div>
  )}
  <figcaption>
    {shot.caption} (Zed {shot.zedVersion}, Playwright Runner {shot.extensionVersion}, {shot.platform})
  </figcaption>
</figure>

<style>
  .shot {
    margin: 1.5rem 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
  }
  .shot .placeholder {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .shot figcaption {
    margin-top: 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .shot figcaption::before {
    content: '// ';
    color: var(--sl-color-accent);
  }
</style>
