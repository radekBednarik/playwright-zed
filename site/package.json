{
  "name": "playwright-zed-docs",
  "private": true,
  "version": "0.0.0",
  "description": "Documentation site for the Playwright Runner Zed extension (feature 010)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run sync-parity",
    "dev": "astro dev",
    "prebuild": "npm run sync-parity",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run sync-parity && astro check && npm run check-screenshots",
    "sync-parity": "node scripts/sync-parity.ts",
    "check-screenshots": "node scripts/check-screenshots.ts",
    "check-links": "node scripts/check-external-links.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/starlight": "0.42.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.4",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0",
    "typescript": "6.0.3"
  }
}
